      where,
      orderBy: { created_at: 'desc' },
      skip: (page - 1) * limit,
      take: limit,
    });
    res.json({ success: true, items, total });
  } catch (err) {
    res.status(500).json({ success: false, message: 'Gagal mengambil data inventory.' });
  }
});

